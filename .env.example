TELEGRAM_BOT_TOKEN=

# Multi-user: comma-separated Telegram chat IDs (preferred)
TELEGRAM_ALLOWED_IDS=123456789,987654321
# Legacy single-user fallback (used if TELEGRAM_ALLOWED_IDS is not set)
TELEGRAM_CHAT_ID=

# LLM provider: vllm | ollama | openrouter | openai
LLM_PROVIDER=vllm

# vLLM (LLM_PROVIDER=vllm)
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_MODEL_NAME=

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL_NAME=

# OpenRouter (LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

CONVERSATION_WINDOW=20
DAILY_CHECKIN_TIME=08:00
TIMEZONE=America/Chicago

# Google Calendar integration (optional)
# Create OAuth credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Use "Desktop app" type; set redirect URI to urn:ietf:wg:oauth:2.0:oob for CLI flow
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Web dashboard (optional)
# Leave DASHBOARD_API_KEY blank to disable auth (dev mode only)
DASHBOARD_API_KEY=
DASHBOARD_CORS_ORIGINS=http://localhost:3000
